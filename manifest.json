{
  "manifest_version": 2,
  "name": "URL Keybinds (Command-Based)",
  "version": "1.0",
  "description": "Up to 99 keyboard shortcuts that open configured URLs in a new tab.",
  "browser_specific_settings": {
    "gecko": {
      "id": "url-shortcuts-commands@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "store.js",
      "background.js"
    ],
    "persistent": false
  },
